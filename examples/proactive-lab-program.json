{
  "authorized": true,
  "include": [
    "127.0.0.1"
  ],
  "exclude": [],
  "allowed_modes": [
    "passive",
    "active",
    "manual"
  ],
  "scan": {
    "allow_private": true,
    "ports": [
      8901
    ],
    "max_requests": 20,
    "max_depth": 2,
    "rate_per_second": 2,
    "timeout": 3,
    "max_seconds": 30,
    "max_response_bytes": 262144,
    "path_prefixes": [
      "/"
    ],
    "excluded_paths": []
  },
  "orchestration": {
    "enabled": true,
    "tools": [
      "nmap",
      "curl",
      "whatweb",
      "wpscan",
      "searchsploit"
    ],
    "external_http": false,
    "timeout": 30,
    "max_seconds": 120,
    "max_output_bytes": 2097152,
    "nmap_tcp_ports": [
      8901
    ],
    "nmap_udp_ports": [],
    "nmap_os": false,
    "network_authorized_ips": [
      "127.0.0.1/32"
    ],
    "allow_wpscan_api": false
  }
}
